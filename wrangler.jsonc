{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uanl-repo-search",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "main": ".svelte-kit/cloudflare/_worker.js",
  "kv_namespaces": [
    {
      "binding": "STATS_KV",
      // Real namespace IDs are filled in by scripts/deploy-cloudflare.sh
      // (wrangler kv namespace create). These placeholders keep local
      // `wrangler dev` working via miniflare's in-memory KV.
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000",
    },
  ],
}
